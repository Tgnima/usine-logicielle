# Les secrets de l'usine logicielle. Copier en .env (jamais suivi par Git) et
# remplir. Ne jamais coller ces valeurs dans une conversation.

# --- GitHub (obligatoire) ---------------------------------------------------
# Jeton « fine-grained » sur le compte qui reçoit les produits, accès à TOUS les
# dépôts (l'usine en crée), permissions : Administration (lecture/écriture, pour
# créer les dépôts), Contents, Issues, Pull requests (lecture/écriture), Metadata (lecture).
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# Le dépôt d'état tiré par le déployeur (proprietaire/nom, comme dans usine.config.yml).
DEPOT_ETAT=Tgnima/usine-etat
# Facultatif : un jeton en LECTURE seule pour le déployeur (sinon GITHUB_TOKEN).
DEPLOY_TOKEN=

# --- Entre l'orchestrateur et ses ateliers (obligatoire) ---------------------
# Une longue valeur aléatoire : openssl rand -hex 32
WORKER_TOKEN=

# --- Les modèles -----------------------------------------------------------
# Claude Code (analyste et atelier) : abonnement Claude, jeton obtenu par
# « claude setup-token » sur un poste avec navigateur. Ou une clé API.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Codex (vérificateur) : connexion ChatGPT stockée dans un volume Docker.
# Réutiliser un volume déjà connecté, ou en laisser un nouveau (voir README).
CODEX_VOLUME=usine-logicielle-codex
OPENAI_API_KEY=
# Les produits, quand ils appellent un modèle (Vercel AI Gateway). Facultatif :
# sans clé, les produits utilisent un texte de secours.
AI_GATEWAY_API_KEY=

# --- Slack (facultatif : sans Slack, pilotage par la CLI) ---------------------
# Application créée depuis slack-manifest.yml.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Le canal où l'usine poste (identifiant C…). Vide : le canal de la commande.
SLACK_CANAL=
# Qui peut valider, décider, mettre en production (identifiants U…, séparés par des virgules).
ADMIN_USER_IDS=

# --- Web ---------------------------------------------------------------------
HTTPS=1
CADDY_EMAIL=
# Protéger la page des emails capturés : utilisateur:motdepasse (vide = ouverte).
MAILPIT_UI_AUTH=
MEMOIRE_PRODUIT=384m
