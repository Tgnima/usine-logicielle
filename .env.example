# Les réglages de l'usine logicielle. Copié en .env par install.sh.
# LES SECRETS : colle-les ici, puis lance « bash install.sh » : ils sont chiffrés
# (SOPS + age, secrets.sops.env) puis effacés de ce fichier. Pour en changer un
# plus tard : le recoller ici et relancer install.sh, ou « bash secrets.sh editer ».
# Ne jamais coller ces valeurs dans une conversation.

# --- GitHub (obligatoire) ---------------------------------------------------
# Jeton « fine-grained » sur le compte qui reçoit les produits, accès à TOUS les
# dépôts (l'usine en crée), permissions : Administration (lecture/écriture, pour
# créer les dépôts), Contents, Issues, Pull requests (lecture/écriture), Metadata (lecture).
# https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
# Le dépôt d'état tiré par le déployeur : TON compte, « proprietaire/usine-etat » (comme
# github.proprietaire et github.depot_etat dans usine.config.yml). Jamais celui d'une autre usine.
DEPOT_ETAT=
# Facultatif : un jeton en LECTURE seule pour le déployeur (sinon GITHUB_TOKEN). Inutile si
# GitHub est connecté dans la console : la mise à jour de l'usine passe alors par cette connexion.
DEPLOY_TOKEN=

# --- Entre l'orchestrateur et ses ateliers (obligatoire) ---------------------
# Générés automatiquement par install.sh (un jeton par serveur de travaux) : laisser vides.
WORKER_TOKEN=
ATELIER_TOKEN=
VERIFICATEUR_TOKEN=

# --- Les modèles -----------------------------------------------------------
# Claude Code (analyste et atelier) : abonnement Claude, jeton obtenu par
# « claude setup-token » sur un poste avec navigateur. Ou une clé API.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
# Codex (vérificateur) : connexion ChatGPT stockée dans un volume Docker.
# Réutiliser un volume déjà connecté, ou en laisser un nouveau (voir README).
CODEX_VOLUME=usine-logicielle-codex
OPENAI_API_KEY=
# Les produits, quand ils appellent un modèle (Vercel AI Gateway). Facultatif :
# sans clé, les produits utilisent un texte de secours.
AI_GATEWAY_API_KEY=

# --- Slack (facultatif : sans Slack, pilotage par la CLI) ---------------------
# Application créée depuis slack-manifest.yml.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Le canal où l'usine poste (identifiant C…). Vide : le canal de la commande.
SLACK_CANAL=
# Qui peut valider, décider, mettre en production (identifiants U…, séparés par des virgules).
# Vide : personne dans Slack (la console reste utilisable). « * » : tout l'espace de travail,
# à n'écrire qu'en connaissance de cause.
ADMIN_USER_IDS=

# --- Emails réels (facultatif) ------------------------------------------------
# Utilisés seulement si une mise en production choisit « emails réels ».
# Un service d'envoi (Brevo, Mailjet, SES, Gmail avec mot de passe d'application…).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1 pour le port 465 (TLS direct), vide pour 587 (STARTTLS)
SMTP_SECURE=
EMAIL_EXPEDITEUR=

# --- Observabilité (facultatif) -------------------------------------------------
# Les erreurs, le battement de cœur et l'état de l'usine et de chaque produit. Vides : rien ne part.
# Comptes à créer en RÉGION EUROPÉENNE. Un seul DSN et un seul jeton pour l'usine et tous les
# produits : chaque envoi porte le produit en étiquette. Aucune donnée personnelle ne sort.
# Sentry (sentry.io, région « European Union ») : un projet Node.js, puis Settings, Projects,
# <le projet>, Client Keys (DSN). Il ressemble à https://<clé>@o<org>.ingest.de.sentry.io/<projet>.
SENTRY_DSN=
# PostHog (eu.posthog.com) : Project settings, « Project token » (commence par phc_).
# Jamais une clé personnelle (phx_).
POSTHOG_TOKEN=
# L'hôte d'envoi de PostHog (pas un secret). Vide : eu.i.posthog.com.
POSTHOG_HOTE=

# --- Adresses ------------------------------------------------------------------
# Le domaine des applications (comme domaine.base dans usine.config.yml) et l'adresse
# du tableau de bord. Tout est derrière la page de connexion de l'usine (le portier) :
# les comptes se gèrent dans Slack avec /usine acces.
# Vide : install.sh le déduit de l'IP publique du serveur (<ip-avec-tirets>.sslip.io).
DOMAINE_BASE=
# Facultatif : une adresse de plus pour la console (sinon console.<DOMAINE_BASE>).
TABLEAU_HOTE=

# --- Web ---------------------------------------------------------------------
HTTPS=1
CADDY_EMAIL=
MEMOIRE_PRODUIT=384m
